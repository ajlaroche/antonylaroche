{
  "name": "antonylaroche-portfolio",
  "version": "2.0.0",
  "description": "Antony Laroche portfolio site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c yellow,cyan \"vite\" \"node --watch --env-file-if-exists=.env server/index.js\"",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "morgan": "^1.12.1",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
